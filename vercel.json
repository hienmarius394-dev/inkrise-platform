{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/premium.html",
      "destination": "/profil.html?tab=formations",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/manga.html",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|Discordbot|Slackbot|TelegramBot|LinkedInBot|Pinterest|redditbot|Applebot|SkypeUriPreview|vkShare|W3C_Validator|iframely|Embedly).*"
        }
      ],
      "destination": "/api/og?type=manga"
    },
    {
      "source": "/pack.html",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|Discordbot|Slackbot|TelegramBot|LinkedInBot|Pinterest|redditbot|Applebot|SkypeUriPreview|vkShare|W3C_Validator|iframely|Embedly).*"
        }
      ],
      "destination": "/api/og?type=pack"
    },
    {
      "source": "/auteur.html",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|Discordbot|Slackbot|TelegramBot|LinkedInBot|Pinterest|redditbot|Applebot|SkypeUriPreview|vkShare|W3C_Validator|iframely|Embedly).*"
        }
      ],
      "destination": "/api/og?type=auteur"
    }
  ]
}
